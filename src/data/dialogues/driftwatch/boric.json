{
  "boric_intro": {
    "interaction_roots": {
      "ask": "bi_ask_root",
      "quest": "bi_quest_root"
    },
    "nodes": {
      "0": {
        "npc_text": "Oh, a new face. Haven't seen you on the docks before. Name's Boric.",
        "player_choices": [
          {
            "text": "I'd like to talk.",
            "next_node": "__social_root__"
          },
          {
            "text": "Leave.",
            "closes_dialogue": true
          }
        ]
      },
      "bi_ask_root": {
        "npc_text": "Ask, then. Tide won't wait on either of us.",
        "player_choices": [
          {
            "text": "Tell me about the docks.",
            "next_node": "bi_ask_docks",
            "condition": "world_flags.boric_lore_docks_seen==false"
          },
          {
            "text": "Back.",
            "next_node": "__social_root__"
          }
        ]
      },
      "bi_ask_docks": {
        "npc_text": "Driftwatch lives or starves by what comes over these piers. Fish, lumber, salt, rumor, trouble. If it floats, breaks, or stinks, it ends up under somebody's hands out here.",
        "player_choices": [
          {
            "text": "Back.",
            "next_node": "bi_ask_root",
            "action": "set_flag:boric_lore_docks_seen:true"
          }
        ]
      },
      "bi_quest_root": {
        "npc_text": "If this is about work, say it plain.",
        "player_choices": [
          {
            "text": "I'm looking for work.",
            "next_node": "bi_work",
            "condition": "relationship.npc_boric>=-50 && job.job_dockhand.active==false && job.job_dockhand.fired==false"
          },
          {
            "text": "Can I have my job back?",
            "next_node": "bi_rehiring",
            "condition": "job.job_dockhand.fired==true"
          },
          {
            "text": "I'm looking for work.",
            "next_node": "bi_refuse",
            "condition": "relationship.npc_boric<-50"
          },
          {
            "text": "About the job...",
            "next_node": "bi_work",
            "condition": "job.job_dockhand.active==true"
          },
          {
            "text": "Back.",
            "next_node": "__social_root__"
          }
        ]
      },
      "bi_work": {
        "npc_text": "Dockhands haul crates, lash lines, and mind the tide. Twenty copper a shift. Hours are eight to four, weekdays. Be here before the horn, and don't make me regret putting your name in the ledger.",
        "player_choices": [
          {
            "text": "Hire me.",
            "action": "hire_job:job_dockhand",
            "next_node": "bi_quest_root",
            "condition": "job.job_dockhand.active==false"
          },
          {
            "text": "Back.",
            "next_node": "bi_quest_root"
          }
        ]
      },
      "bi_refuse": {
        "npc_text": "Get off my pier. I don't hire dead weight.",
        "player_choices": [
          {
            "text": "Back.",
            "next_node": "bi_quest_root"
          }
        ]
      },
      "bi_rehiring": {
        "npc_text": "We tried you. Missed days or didn't cut it. You're off the roster.",
        "player_choices": [
          {
            "text": "Please, give me another chance.",
            "action": "try_hire_or_deny:job_dockhand:bi_deny",
            "next_node": "bi_quest_root"
          },
          {
            "text": "Back.",
            "next_node": "bi_quest_root"
          }
        ]
      },
      "bi_deny": {
        "npc_text": "No.",
        "player_choices": [
          {
            "text": "Back.",
            "next_node": "bi_quest_root"
          }
        ]
      }
    }
  },
