{
  "cyrus_default": {
    "interaction_roots": {
      "ask": "cyrus_ask_root",
      "quest": "cyrus_quest_root"
    },
    "nodes": {
      "0": {
        "npc_text": "I'm Cyrus, apprentice to Kaelen. Need something forged?",
        "player_choices": [
          {
            "text": "I'd like to talk.",
            "next_node": "__social_root__"
          },
          {
            "text": "Leave.",
            "closes_dialogue": true
          }
        ]
      },
      "cyrus_ask_root": {
        "npc_text": "Ask what you want. Just don't say it loud.",
        "player_choices": [
          {
            "text": "How is forge work treating you?",
            "next_node": "cyrus_ask_forge",
            "condition": "world_flags.cyrus_lore_forge_seen==false"
          },
          {
            "text": "Back.",
            "next_node": "__social_root__"
          }
        ]
      },
      "cyrus_ask_forge": {
        "npc_text": "Hot, loud, and never finished. Kaelen says iron teaches patience because it punishes anyone too proud to wait for it.",
        "player_choices": [
          {
            "text": "Back.",
            "next_node": "cyrus_ask_root",
            "action": "set_flag:cyrus_lore_forge_seen:true"
          }
        ]
      },
      "cyrus_quest_root": {
        "npc_text": "What is it?",
        "player_choices": [
          {
            "text": "Old Crank says you know about Finn's crates.",
            "next_node": "cyrus_scared",
            "condition": "quest.rebel_path.stage==1 && world_flags.whitefang_bound==false"
          },
          {
            "text": "Back.",
            "next_node": "__social_root__"
          }
        ]
      },
      "cyrus_scared": {
        "npc_text": "Shh! Not so loud! Kaelen doesn't know... I... I just did what they told me!",
        "player_choices": [
          {
            "text": "What did you do?",
            "next_node": "cyrus_confess"
          }
        ]
      },
      "cyrus_confess": {
        "npc_text": "They made me forge these... odd blades. They call them 'Shadow Blades'. I kept one... a prototype. I was going to show the guards, but I was too scared.",
        "player_choices": [
          {
            "text": "Give it to me. I'll take it to the guards.",
            "next_node": "cyrus_give",
            "action": "add_item:prototype_blade:1|advance_quest_stage:rebel_path",
            "condition": "world_flags.whitefang_bound==false"
          }
        ]
      },
      "cyrus_give": {
        "npc_text": "Here. Please, don't tell Finn I gave it to you.",
        "player_choices": [
          {
            "text": "You're safe now.",
            "closes_dialogue": true
          }
        ]
      }
    }
  }
}
