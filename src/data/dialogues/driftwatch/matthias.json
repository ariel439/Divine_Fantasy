    "nodes": {
      "0": {
        "npc_text": "Halt! What business do you have at Mosswatch Keep?",
        "player_choices": [
          {
            "text": "I'd like to talk.",
            "next_node": "__social_root__"
          },
          {
            "text": "Leave.",
            "closes_dialogue": true
          }
        ]
      },
      "matthias_ask_root": {
        "npc_text": "Speak clearly.",
        "player_choices": [
          {
            "text": "Tell me about Mosswatch Keep.",
            "next_node": "matthias_ask_keep",
            "condition": "world_flags.matthias_lore_keep_seen==false"
          },
          {
            "text": "Back.",
            "next_node": "__social_root__"
          }
        ]
      },
      "matthias_ask_keep": {
        "npc_text": "Keep's older than most men posted to it and in better shape than some. It doesn't need to be beautiful. It needs to hold.",
        "player_choices": [
          {
            "text": "Back.",
            "next_node": "matthias_ask_root",
            "action": "set_flag:matthias_lore_keep_seen:true"
          }
        ]
      },
      "matthias_quest_root": {
        "npc_text": "What is it?",
        "player_choices": [
          {
            "text": "I have something to report.",
            "next_node": "matthias_report"
          },
          {
            "text": "Back.",
            "next_node": "__social_root__"
          }
        ]
      },
      "matthias_report": {
        "npc_text": "I don't have time for drunk talk. Make it quick.",
        "player_choices": [
          {
            "text": "[Show Blade] I found this prototype.",
            "next_node": "matthias_evidence",
            "condition": "inventory.prototype_blade>=1"
          },
          {
            "text": "Never mind.",
            "closes_dialogue": true
          }
        ]
      },
      "matthias_evidence": {
        "npc_text": "Let me see that. ... This alloy... this is contraband. Shadow steel. Finn has been smuggling this under our noses?",
