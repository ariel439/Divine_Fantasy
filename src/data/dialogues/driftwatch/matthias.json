{
  "matthias_default": {
    "interaction_roots": {
      "ask": "matthias_ask_root",
      "quest": "matthias_quest_root"
    },
    "nodes": {
      "0": {
        "npc_text": "Halt! What business do you have at Mosswatch Keep?",
        "player_choices": [
          {
            "text": "I'd like to talk.",
            "next_node": "__social_root__"
          },
          {
            "text": "Leave.",
            "closes_dialogue": true
          }
        ]
      },
      "matthias_ask_root": {
        "npc_text": "Speak clearly.",
        "player_choices": [
          {
            "text": "Tell me about Mosswatch Keep.",
            "next_node": "matthias_ask_keep",
            "condition": "world_flags.matthias_lore_keep_seen==false"
          },
          {
            "text": "Back.",
            "next_node": "__social_root__"
          }
        ]
      },
      "matthias_ask_keep": {
        "npc_text": "Keep's older than most men posted to it and in better shape than some. It doesn't need to be beautiful. It needs to hold.",
        "player_choices": [
          {
            "text": "Back.",
            "next_node": "matthias_ask_root",
            "action": "set_flag:matthias_lore_keep_seen:true"
          }
        ]
      },
      "matthias_quest_root": {
        "npc_text": "What is it?",
        "player_choices": [
          {
            "text": "I have something to report.",
            "next_node": "matthias_report"
          },
          {
            "text": "Back.",
            "next_node": "__social_root__"
          }
        ]
      },
      "matthias_report": {
        "npc_text": "I don't have time for drunk talk. Make it quick.",
        "player_choices": [
          {
            "text": "[Show Blade and Note] I found proof Finn is moving contraband through the Mug.",
            "next_node": "matthias_evidence_full",
            "condition": "inventory.prototype_blade>=1 && inventory.marked_crate_note>=1 && world_flags.whitefang_bound==false"
          },
          {
            "text": "[Show Blade] I found this prototype.",
            "next_node": "matthias_evidence_blade_only",
            "condition": "inventory.prototype_blade>=1 && inventory.marked_crate_note<1 && world_flags.whitefang_bound==false"
          },
          {
            "text": "[Show Note] I found this tally note from the forge.",
            "next_node": "matthias_evidence_note_only",
            "condition": "inventory.marked_crate_note>=1 && inventory.prototype_blade<1 && world_flags.whitefang_bound==false"
          },
          {
            "text": "Never mind.",
            "closes_dialogue": true
          }
        ]
      },
      "matthias_evidence_blade_only": {
        "npc_text": "Let me see that. ... This alloy... contraband shadow steel. Enough to trouble me, not enough to move on Finn. I need proof this reaches back to his operation, not just a single forged curiosity.",
        "player_choices": [
          {
            "text": "Then I will keep digging.",
            "closes_dialogue": true
          }
        ]
      },
      "matthias_evidence_note_only": {
        "npc_text": "A tally note proves someone was moving crates at dusk, not what was inside them. Suspicious, yes. Not enough for a warrant against Finn.",
        "player_choices": [
          {
            "text": "I need harder proof.",
            "closes_dialogue": true
          }
        ]
      },
      "matthias_evidence_full": {
        "npc_text": "Let me see both. ... Shadow steel in prototype form, and a forge tally routing marked crates to the Mug cellar after dusk. That ties the contraband to Finn's operation cleanly enough for me.",
        "player_choices": [
          {
            "text": "So we can move on him?",
            "next_node": "matthias_plan"
          }
        ]
      },
      "matthias_plan": {
        "npc_text": "This is enough for a warrant. Go to Sergeant Rodrick in the Tidehunter Quarter. He will organize the raid.",
        "player_choices": [
          {
            "text": "I'll go now.",
            "closes_dialogue": true,
            "action": "advance_quest_stage:rebel_path|remove_item:prototype_blade:1|remove_item:marked_crate_note:1",
            "condition": "world_flags.whitefang_bound==false"
          }
        ]
      },
      "matthias_raid_ready": {
        "npc_text": "My men are on standby. Go to the Salty Mug. The option to Raid will be available.",
        "player_choices": [
          {
            "text": "Understood.",
            "closes_dialogue": true
          }
        ]
      }
    }
  }
}
