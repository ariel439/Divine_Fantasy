{
  "old_crank_default": {
    "interaction_roots": {
      "ask": "crank_ask_root"
    },
    "nodes": {
      "0": {
        "npc_text": "Bah! Another whelp in the tavern. (He eyes your drink).",
        "player_choices": [
          {
            "text": "Slide him a beer.",
            "player_text": "Here. Have a drink.",
            "next_node": "crank_gossip_1",
            "action": "remove_item:beer:1|set_flag:crank_beer_1:true",
            "condition": "inventory.beer>=1 && world_flags.crank_beer_1==false"
          },
          {
            "text": "Slide him a beer.",
            "player_text": "Another one for you.",
            "next_node": "crank_gossip_2",
            "action": "remove_item:beer:1|set_flag:crank_beer_2:true",
            "condition": "inventory.beer>=1 && world_flags.crank_beer_1==true && world_flags.crank_beer_2==false"
          },
          {
            "text": "Slide him a beer.",
            "player_text": "One more, old man.",
            "next_node": "crank_gossip_3",
            "action": "remove_item:beer:1|set_flag:crank_beer_3:true|start_quest:rebel_path|advance_quest_stage:rebel_path",
            "condition": "inventory.beer>=1 && world_flags.crank_beer_2==true && world_flags.crank_beer_3==false && world_flags.whitefang_bound==false"
          },
          {
            "text": "Slide him a beer.",
            "player_text": "One more, old man.",
            "next_node": "crank_gossip_3_whitefang",
            "action": "remove_item:beer:1|set_flag:crank_beer_3:true",
            "condition": "inventory.beer>=1 && world_flags.crank_beer_2==true && world_flags.crank_beer_3==false && world_flags.whitefang_bound==true"
          },
          {
            "text": "I'd like to talk.",
            "next_node": "__social_root__"
          },
          {
            "text": "Leave.",
            "closes_dialogue": true
          }
        ]
      },
      "crank_ask_root": {
        "npc_text": "Ask, if you must. I've heard worse ways to waste time.",
        "player_choices": [
          {
            "text": "You've seen this tavern a long time, haven't you?",
            "next_node": "crank_ask_mug",
            "condition": "world_flags.crank_lore_mug_seen==false"
          },
          {
            "text": "Back.",
            "next_node": "__social_root__"
          }
        ]
      },
      "crank_ask_mug": {
        "npc_text": "Long enough to watch boys turn into drunks and drunks turn into ghosts. The Mug changes its owner, its stools, its spills. Never its smell.",
        "player_choices": [
          {
            "text": "Back.",
            "next_node": "crank_ask_root",
            "action": "set_flag:crank_lore_mug_seen:true"
          }
        ]
      },
      "crank_gossip_1": {
        "npc_text": "Ah... that hits the spot. Did you know Roberta at Tide & Trade has been skimming off the top? Her 'fresh' fish ain't always fresh.",
        "player_choices": [
          {
            "text": "Interesting.",
            "next_node": "0"
          }
        ]
      },
      "crank_gossip_2": {
        "npc_text": "More? You're alright, kid. Captain Elias... he keeps a bottle of rum in his desk. Drinks on the job, he does.",
        "player_choices": [
          {
            "text": "Is that so?",
            "next_node": "0"
          }
        ]
      },
      "crank_gossip_3": {
        "npc_text": "Listen close. Finn... he's dealing in illegal weapons. I saw his boys moving crates to the Forge. Talk to Cyrus, the apprentice. He knows.",
        "player_choices": [
          {
            "text": "I'll investigate.",
            "next_node": "0"
          }
        ]
      },
      "crank_gossip_3_whitefang": {
        "npc_text": "You? Chasing tavern rumors still? Hah. Forget Cyrus. Driftwatch's small rot won't matter much to a man carrying mountain weather in his bones. Buy me another beer tomorrow and I'll tell you which fools in this city have already started noticing.",
        "player_choices": [
          {
            "text": "Maybe another time.",
            "next_node": "0"
          }
        ]
      }
    }
  }
}
