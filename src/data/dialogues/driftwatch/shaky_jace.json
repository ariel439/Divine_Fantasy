{
  "shaky_jace_default": {
    "interaction_roots": {
      "gift": "jace_gift_root",
      "ask": "jace_ask_root",
      "quest": "jace_quest_root"
    },
    "nodes": {
      "jace_gift_root": {
        "npc_text": "Spare a coin? Just one... please...",
        "player_choices": [
          {
            "text": "Slip him a copper.",
            "player_text": "Here. Don't waste it.",
            "next_node": "jace_gift_accepted",
            "action": "social_action:npc_shaky_jace:gift:currency:copper:1",
            "condition": "currency.copper>=1"
          },
          {
            "text": "Nothing today.",
            "next_node": "__social_root__"
          }
        ]
      },
      "jace_gift_accepted": {
        "npc_text": "Bless you... bless you... that'll keep me warm tonight.",
        "player_choices": [
          {
            "text": "Back.",
            "next_node": "__social_root__"
          }
        ]
      },
      "jace_ask_root": {
        "npc_text": "Ask fast. My hands don't stop shaking for free.",
        "player_choices": [
          {
            "text": "Back.",
            "next_node": "__social_root__"
          }
        ]
      },
      "jace_quest_root": {
        "npc_text": "Well? Coin or questions?",
        "player_choices": [
          {
            "text": "Slip him a copper.",
            "player_text": "Here. Get yourself through the night.",
            "next_node": "jace_talk",
            "condition": "currency.copper>=1 && world_flags.finn_debt_collection_active==true && world_flags.debt_paid_by_elara==false && world_flags.elara_secret_known==false"
          },
          {
            "text": "Slip him a copper.",
            "player_text": "Here. Don't waste it.",
            "next_node": "jace_thanks",
            "condition": "currency.copper>=1 && world_flags.elara_secret_known==true"
          },
          {
            "text": "Back.",
            "next_node": "__social_root__"
          }
        ]
      },
      "jace_talk": {
        "npc_text": "Bless you! Bless you! The lady at the Hovel... she has the good stuff. The BEST stuff. But only at night... shhh.",
        "player_choices": [
          {
            "text": "The Herbalist? Elara?",
            "next_node": "jace_secret"
          }
        ]
      },
      "jace_secret": {
        "npc_text": "Yes, yes! She sells to us... keeps us warm... don't tell the guards! She'll stop selling!",
        "player_choices": [
          {
            "text": "Interesting. (Leave)",
            "closes_dialogue": true,
            "action": "set_flag:elara_secret_known:true"
          }
        ]
      },
      "jace_thanks": {
        "npc_text": "Bless you... bless you... that'll keep me warm tonight.",
        "player_choices": [
          {
            "text": "Leave.",
            "closes_dialogue": true
          }
        ]
      }
    }
  }
}
